      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "Y_pred = pipeline_LR.predict(X_test)\n",
    "conf_matrix = confusion_matrix(Y_test, Y_pred)\n",
    "disp = ConfusionMatrixDisplay(confusion_matrix=conf_matrix, display_labels=pipeline_LR.classes_)\n",
    "disp.plot()\n",
    "plt.title(\"Confusion Matrix for LogRegCV\")\n",
    "plt.show()\n"
   ]
  },
